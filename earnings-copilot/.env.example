# Copy this file, name the copy ".env", and fill in the values after the = signs.
# Never share .env or upload it: it's listed in .gitignore.

# Your Claude API key, from console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# Your email address. The SEC asks everyone using its free data to give a contact.
SEC_CONTACT_EMAIL=

# Optional: a password needed to run AI reports on the website. Set this when
# the site is public, so strangers can't spend your API credit.
APP_PASSWORD=
